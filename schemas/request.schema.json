{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Booking request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "booking_url",
    "expected_class",
    "reserve_for",
    "permitted_actions",
    "policy_version",
    "allow_monetary_charge",
    "dry_run"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "booking_url": { "type": "string", "format": "uri", "minLength": 1 },
    "expected_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "date", "start_time", "timezone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "start_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "type": "string",
          "pattern": "^America(?:/[A-Za-z0-9._+-]+)+$"
        }
      }
    },
    "reserve_for": { "const": "myself" },
    "permitted_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["book", "waitlist"] }
    },
    "policy_version": { "type": "string", "minLength": 1 },
    "allow_monetary_charge": { "const": false },
    "dry_run": { "type": "boolean" }
  }
}
