{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Booking journal record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "state"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "format": "uuid" },
    "state": {
      "enum": [
        "INITIALIZED",
        "VALIDATED",
        "READY_TO_SUBMIT",
        "SUBMITTING",
        "CONFIRMED"
      ]
    }
  }
}
