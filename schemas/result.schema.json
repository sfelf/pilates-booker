      },
      "required": ["availability", "observed_class"],
      "properties": {
        "outcome": { "const": "DRY_RUN" },
        "exit_code": { "const": 0 },
        "action_submitted": { "const": false },
        "confirmation_verified": { "const": true },
        "availability": { "const": "ALREADY_WAITLISTED" },
        "observed_class": true,
        "safety_checks": {
          "type": "object",
          "properties": { "exact_class_match": { "const": true } }
        }
      }
    },
    {
      "propertyNames": {
        "enum": [
          "schema_version",
          "request_id",
          "outcome",
          "exit_code",
          "action_submitted",
          "confirmation_verified",
          "observed_class",
          "package_selected",
          "packages_before",
          "safety_checks",
          "details"
        ]
      },
      "not": {
        "anyOf": [
          {
            "required": ["package_selected"],
            "properties": { "package_selected": true, "packages_before": true },
            "not": {
              "required": ["packages_before"],
              "properties": { "packages_before": true }
            }
          },
          {
            "required": ["packages_before"],
            "properties": { "package_selected": true, "packages_before": true },
            "not": {
              "required": ["package_selected"],
              "properties": { "package_selected": true }
            }
          }
        ]
      },
      "properties": {
        "outcome": { "const": "SAFE_STOP" },
        "exit_code": { "const": 20 },
        "action_submitted": { "const": false },
        "confirmation_verified": { "const": false }
      }
    },
    {
      "propertyNames": {
        "enum": [
          "schema_version",
