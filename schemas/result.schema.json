      "properties": {
        "outcome": { "const": "DRY_RUN" },
        "exit_code": { "const": 0 },
        "action_submitted": { "const": false },
        "confirmation_verified": { "const": false },
        "availability": { "enum": ["BOOKING_AVAILABLE", "WAITLIST_AVAILABLE"] },
        "observed_class": true,
        "package_selected": { "type": "string", "minLength": 1 },
        "packages_before": { "type": "array", "minItems": 1 },
        "safety_checks": {
          "type": "object",
