          "outcome",
          "exit_code",
          "action_submitted",
          "confirmation_verified",
          "safety_checks",
          "details"
        ]
      },
      "properties": {
        "outcome": { "const": "CONFIRMATION_UNCERTAIN" },
        "exit_code": { "const": 40 },
        "action_submitted": { "const": true },
        "confirmation_verified": { "const": false },
        "safety_checks": {
          "type": "object",
          "properties": {
            "exact_class_match": { "const": true },
            "approved_package_verified": { "const": true },
