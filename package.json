{
  "name": "pilates-booker",
  "private": true,
  "version": "0.2.4",
  "description": "A command-line assistant to book or waitlist a Pilates class.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfelf/pilates-booker.git"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "format": "prettier --write README.md .github schemas src tests package.json tsconfig.json tsconfig.build.json eslint.config.js .prettierrc.json",
    "format:check": "prettier --check README.md .github schemas src tests package.json tsconfig.json tsconfig.build.json eslint.config.js .prettierrc.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=src --coverage.reporter=text --coverage.reporter=lcov"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
